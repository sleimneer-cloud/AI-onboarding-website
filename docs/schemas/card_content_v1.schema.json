{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ix-value-loop.local/schemas/card-content-v1.json",
  "title": "CardContentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key_actions",
    "value_connection",
    "evidence_summary",
    "discovery",
    "judgment_change",
    "work_impact",
    "next_action",
    "grounding_warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "key_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/keyActionText"
      }
    },
    "value_connection": {
      "$ref": "#/$defs/narrativeText"
    },
    "evidence_summary": {
      "$ref": "#/$defs/evidenceSummaryText"
    },
    "discovery": {
      "$ref": "#/$defs/narrativeText"
    },
    "judgment_change": {
      "$ref": "#/$defs/narrativeText"
    },
    "work_impact": {
      "$ref": "#/$defs/narrativeText"
    },
    "next_action": {
      "$ref": "#/$defs/narrativeText"
    },
    "grounding_warnings": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/groundingWarning"
      }
    }
  },
  "$defs": {
    "keyActionText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_refs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidenceSummaryText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_refs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "narrativeText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_refs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "groundingWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "message",
        "source_refs"
      ],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "key_actions",
            "value_connection",
            "evidence_summary",
            "discovery",
            "judgment_change",
            "work_impact",
            "next_action"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
