# Application
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:5173
APP_VERSION=0.1.0

# PostgreSQL is optional while running the scaffold. /ready returns 503 when unset.
DATABASE_URL=
DATABASE_READY_TIMEOUT_SECONDS=2

# Optional repository-root-relative override. Defaults to frontend/dist.
FRONTEND_DIST_DIR=frontend/dist
