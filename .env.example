# Application
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:5173
APP_VERSION=0.1.0

# Required for authentication. Use a random value of at least 32 UTF-8 bytes.
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# PostgreSQL is required for migration, seed, and /ready success.
DATABASE_URL=
DATABASE_READY_TIMEOUT_SECONDS=2

# Evidence Card generation. Groq failures fall back to the labeled deterministic Mock.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_OUTPUT_MODE=strict_json_schema
AI_TOTAL_BUDGET_SECONDS=8
AI_MAX_RETRIES=1
AI_FALLBACK_TO_MOCK=true
AI_PROMPT_VERSION=v1
AI_SCHEMA_VERSION=1.0

# Fictional demo fixture only. Override outside the checked-in example.
DEMO_ACCOUNT_PASSWORD=DemoPassword!
DEMO_REFERENCE_DATE=2026-08-02

# Optional repository-root-relative override. Defaults to frontend/dist.
FRONTEND_DIST_DIR=frontend/dist
